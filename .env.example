GEMINI_API_KEY=
# when LLM_MODEL=deepseek:...
DEEPSEEK_API_KEY=
# Gemma 4 id from models.list, or provider:model e.g. deepseek:deepseek-chat
LLM_MODEL=deepseek:deepseek-chat
# empty = LLM_MODEL
AGENT_MODEL=
# mock | live
DEVDRAFT_MODE=mock
DEVDRAFT_CLIENT_KEY=
DEVDRAFT_CLIENT_SECRET=
DEVDRAFT_WEBHOOK_SECRET=
# blank locally = the URL the page was opened on; set to the app URL when deployed
PUBLIC_BASE_URL=
# set the real rate on the day
FX_ZMW_PER_USD=26.5
# 0.01 for live demo so a K450 bill charges cents
CHARGE_SCALE=1
MAX_TXN_USD=5
MAX_TEAM_USD=50
DATABASE_URL=sqlite:///tracksplit.db
